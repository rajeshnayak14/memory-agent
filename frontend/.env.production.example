# Set this as an environment variable in your Vercel (or other static
# host) project settings — not as a committed file. Vite bakes it into
# the build at build time, so it must be set BEFORE deploying.
VITE_API_BASE_URL=https://your-backend.onrender.com

# Same Google OAuth Client ID as the backend's GOOGLE_CLIENT_ID. Optional —
# the Google Sign-In button just doesn't render if this is unset.
VITE_GOOGLE_CLIENT_ID=
