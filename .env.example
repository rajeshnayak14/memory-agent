# Copy this to .env for local dev (already gitignored), or set these as
# environment variables directly in your hosting provider's dashboard.

# Google Gemini API key (used for chat + embeddings).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Postgres connection string. Must be a Postgres instance with the
# `vector` extension available — LangGraph's memory store uses it for
# embedding similarity search. Neon and Supabase both support this on
# their free tiers.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Any long random string — used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Only needed in production. The deployed frontend's origin(s), so the
# backend's CORS policy allows it — comma-separated if there's more than
# one (e.g. a Vercel preview URL and your custom domain). Leave unset for
# local dev; localhost is always allowed regardless of this setting.
# Example: https://your-app.vercel.app,https://yourdomain.com
FRONTEND_URL=

# Comma-separated email addresses that get auto-promoted to admin the first
# time they register or log in. Safe to leave set permanently — it only
# ever grants, never revokes (removing an email here doesn't demote an
# already-promoted admin).
ADMIN_EMAILS=

# SendGrid API key, used to send the mandatory login verification code
# over HTTPS — every login for every account with an email requires this.
# Without it set, login for any such account will fail at the OTP-send
# step. (Raw SMTP was tried first but is blocked on Render's free tier —
# this is why it's an HTTP API instead.)
#
# Sign up free at https://sendgrid.com, then:
#   1. Settings -> Sender Authentication -> Single Sender Verification ->
#      verify an email address you control (no domain needed, no DNS —
#      just click the confirmation link SendGrid emails you). Once
#      verified, you can send TO any recipient, not just that address.
#   2. Settings -> API Keys -> Create API Key -> Restricted Access with
#      Mail Send enabled.
SENDGRID_API_KEY=

# Must exactly match the single sender address you verified above.
SENDGRID_FROM=
